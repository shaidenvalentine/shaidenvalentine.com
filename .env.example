# Resend — powers the Work-With-Me application + anonymous feedback emails.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where submissions are emailed. Defaults to the vCard email in content/profile.ts.
CONTACT_EMAIL=hello@shaidenvalentine.com

# The "from" address. Must be on a domain you've verified in Resend.
# Until your domain is verified, Resend's sandbox sender works for testing:
#   RESEND_FROM=Portal <onboarding@resend.dev>
RESEND_FROM=Shaiden Valentine <portal@shaidenvalentine.com>
